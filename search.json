---
layout: null
---
[
{% assign search_docs = site.pages | where_exp: "p", "p.layout == 'post'" %}
{% assign all_items = site.posts | concat: search_docs %}
{% for item in all_items %}
  {
    "title": {{ item.title | jsonify }},
    "url": "{{ item.url | relative_url }}",
    "date": "{{ item.date | date: '%b %d, %Y' | default: '' }}",
    "excerpt": {{ item.excerpt | strip_html | strip_newlines | jsonify }},
    "content": {{ item.content | strip_html | strip_newlines | jsonify }},
    "tags": {{ item.tags | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]